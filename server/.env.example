PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/restora_db
CLIENT_URL=http://localhost:5173
JWT_SECRET=supersecretjwtkey_replace_in_production
JWT_EXPIRES_IN=7d

# Optional Email / SMTP configuration (Gmail, SendGrid, Mailtrap, etc.)
# If left blank, automated emails are simulated with full console logs & preview URLs in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Restora Platform <onboarding@restora.com>"
